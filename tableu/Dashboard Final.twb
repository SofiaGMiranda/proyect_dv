      <aliases enabled='yes' />
      <column caption='Avg Sales' datatype='real' name='[Avg_Sales]' role='measure' type='quantitative' />
      <column caption='VariacionYoY' datatype='real' name='[Calculation_0091825592004609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]),-1)) / ABS(LOOKUP(SUM([Sales]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtro Region Calc' datatype='boolean' name='[Calculation_0091825640374274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 2] = &quot;All&quot; OR [Region (ranking_regiones.csv)] = [Parameters].[Parámetro 2]' />
      </column>
      <column caption='Filtro Año' datatype='boolean' name='[Calculation_1089907343032320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 3] = 0 OR [Year] = [Parameters].[Parámetro 3]' />
      </column>
      <column caption='Filtro Categoría' datatype='boolean' name='[Calculation_1089907346690049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 4] = &quot;Todos&quot; OR [Category] = [Parameters].[Parámetro 4]' />
      </column>
      <column caption='Ventas año actual' datatype='real' name='[Calculation_1089907464306692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) THEN [Sales] END) }' />
      </column>
      <column caption='Ventas año anterior' datatype='real' name='[Calculation_1089907464368133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Sales] END) }' />
      </column>
      <column caption='Variación Ventas %' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_1089907464454150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = 2015 THEN 0&#13;&#10;ELSEIF [Parameters].[Parámetro 3] = 0 THEN&#13;&#10;&#13;&#10;(&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Sales] END) }&#13;&#10;ELSE&#13;&#10;(&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Sales] END) }&#13;&#10;END' />
      </column>
      <column caption='Varicion Ordenes' datatype='real' name='[Calculation_1089907474952199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = 0 THEN&#13;&#10;(&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) THEN [Order ID] END) }&#13;&#10;-&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Order ID] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Order ID] END) }&#13;&#10;ELSE&#13;&#10;(&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] THEN [Order ID] END) }&#13;&#10;-&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Order ID] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : COUNTD(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Order ID] END) }&#13;&#10;END' />
      </column>
      <column caption='%Pct region' datatype='real' name='[Calculation_1089907477041160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region] : SUM([Sales]) } / { FIXED : SUM([Sales]) }' />
      </column>
      <column caption='Var cater' datatype='real' name='[Calculation_1089907479318537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = 0 THEN&#13;&#10;(&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 THEN [Sales] END) }&#13;&#10;ELSE&#13;&#10;(&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED [Category] : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 THEN [Sales] END) }&#13;&#10;END' />
      </column>
      <column caption='var tec' datatype='real' name='[Calculation_1089907480535050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = 0 THEN&#13;&#10;(&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = YEAR({MAX([Order Date])}) - 1 AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;ELSE&#13;&#10;(&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;-&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parámetro 3] - 1 AND [Category] = &quot;Technology&quot; THEN [Sales] END) }&#13;&#10;END' />
      </column>
