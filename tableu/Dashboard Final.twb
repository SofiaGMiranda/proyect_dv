                  </zone-style>
                </zone>
              </zone>
              <zone h='9756' id='30' is-scaled='1' param='C:/Users/papit/Downloads/5811316.png' type-v2='bitmap' w='9765' x='625' y='976'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
