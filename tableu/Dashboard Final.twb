  <worksheets>
    <worksheet name='Comparación de regiones'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Distribución por región</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='8'>Vista de comparación — ventas totales 2015 - 2018</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RETAIL' name='federated.1klcl5100vhxwn1ecv2xr13cicy8' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Filtro Region' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1klcl5100vhxwn1ecv2xr13cicy8'>
            <column caption='Filtro Region Calc' datatype='boolean' name='[Calculation_0091825640374274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parámetro 2] = &quot;All&quot; OR [Region (ranking_regiones.csv)] = [Parameters].[Parámetro 2]' />
            </column>
            <column caption='Category (estacionalidad categoria.csv)' datatype='string' name='[Category (estacionalidad_categoria.csv)]' role='dimension' type='nominal' />
